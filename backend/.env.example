NODE_ENV=development
PORT=3000
# PostgreSQL
DATABASE_URL=postgresql://srs_user:srs_password@localhost:5432/srs_db
# MongoDB
MONGO_URI=mongodb://srs_admin:srs_mongo_pass@localhost:27017/srs_mongo?authSource=admin
# Redis
# REDIS_URL=redis://srs_redis_pass@127.0.0.1:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=srs_redis_pass
REDIS_SESSION_TTL=3600       
REDIS_CACHE_TTL=300   
# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=srs_neo4j_pass
# Cassandra

CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=srs_events
CASSANDRA_USER=cassandra
CASSANDRA_PASSWORD=cassandra
CASSANDRA_REPLICATION_FACTOR=1

# CASSANDRA_CONTACT_POINTS=localhost
# CASSANDRA_KEYSPACE=srs_events
# CASSANDRA_USER=cassandra
# CASSANDRA_PASSWORD=cassandra
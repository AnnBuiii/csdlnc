# =============================================================
# .env – Biến môi trường Smart Recruitment System
# SAO CHÉP file này thành .env và thay giá trị thực
# KHÔNG commit file .env thật lên Git
# =============================================================

NODE_ENV=development

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=change_me_super_secret_jwt_key_256bit
JWT_EXPIRES_IN=7d

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=srs_db
POSTGRES_USER=srs_user
POSTGRES_PASSWORD=srs_password

# ── pgAdmin ───────────────────────────────────────────────────
PGADMIN_PASSWORD=srs_pgadmin_pass

# ── MongoDB ───────────────────────────────────────────────────
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=srs_mongo
MONGO_ROOT_USER=srs_admin
MONGO_ROOT_PASSWORD=srs_mongo_pass

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=srs_redis_pass
REDIS_SESSION_TTL=3600
REDIS_CACHE_TTL=300

# ── Neo4j ─────────────────────────────────────────────────────
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=srs_neo4j_pass

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ── OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# ── File Upload ───────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,doc,docx
UPLOAD_PATH=/app/uploads
